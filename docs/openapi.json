              "description": "Filter by chapter",
              "title": "Chapter"
            },
            "description": "Filter by chapter"
          },
          {
            "name": "fuzzy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.1,
              "description": "Fuzzy threshold",
              "default": 0.3,
              "title": "Fuzzy"
            },
            "description": "Fuzzy threshold"
          },
          {
            "name": "autocomplete",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Autocomplete mode",
              "default": false,
              "title": "Autocomplete"
            },
            "description": "Autocomplete mode"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
