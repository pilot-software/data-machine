            "schema": {
              "type": "string",
              "description": "Comma-separated: icd10,icd11",
              "default": "icd10,icd11",
              "title": "Systems"
            },
            "description": "Comma-separated: icd10,icd11"
          },
          {
            "name": "chapter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
