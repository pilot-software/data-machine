"""
Drug Database Endpoints - DEPRECATED
Use /api/v1/snomed endpoints instead for 89K+ Indian brands
"""
from fastapi import APIRouter, Query, HTTPException, Depends
from typing import List
from pydantic import BaseModel, Field
from sqlalchemy import text
from app.db.database import SessionLocal
from app.services.search_logger import search_logger
from app.middleware.auth import verify_api_key
import time
import warnings

router = APIRouter(prefix="/api/v1/drugs", tags=["drugs-legacy"], dependencies=[Depends(verify_api_key)])

@router.get("/search", deprecated=True)
async def search_drugs_legacy(q: str = Query(..., min_length=2)):
    """
    DEPRECATED: Use /api/v1/snomed/search instead
    
    Legacy drug search (114 brands only)
    Migrate to SNOMED endpoints for 89K+ brands
    """
    warnings.warn("This endpoint is deprecated. Use /api/v1/snomed/search", DeprecationWarning)
    start = time.time()
    db = SessionLocal()
    try:
        sql = text("""
            SELECT 
                ibd.brand_id, ibd.brand_name, ibd.manufacturer,
                gi.ingredient_name as generic_name, ibd.rxnorm_cui,
                gi.atc_code, ibd.strength, ibd.dosage_form,
                ibd.mrp, ibd.pack_size, gi.indications, gi.symptoms,
                CASE 
                    WHEN LOWER(ibd.brand_name) = LOWER(:q) THEN 1
                    WHEN LOWER(gi.ingredient_name) = LOWER(:q) THEN 2
                    ELSE 3
                END as relevance
            FROM indian_brand_drugs ibd
            JOIN generic_ingredients gi ON ibd.ingredient_id = gi.ingredient_id
            WHERE (ibd.brand_name ILIKE :q_like
                OR gi.ingredient_name ILIKE :q_like
                OR gi.indications ILIKE :q_like
                OR gi.symptoms ILIKE :q_like)
                AND ibd.active = true
            ORDER BY relevance, ibd.mrp
            LIMIT 50
        """)
        
        rows = db.execute(sql, {"q": q, "q_like": f"%{q}%"}).fetchall()
        drugs = [dict(r._mapping) for r in rows]
        
        response_time = (time.time() - start) * 1000
        search_logger.log_search(q, len(drugs), response_time)
        
        return {
            "query": q,
            "found": len(drugs) > 0,
            "total": len(drugs),
            "drugs": drugs,
            "response_time_ms": round(response_time, 2),
            "warning": "DEPRECATED: Use /api/v1/snomed/search for 89K+ brands"
        }
    finally:
        db.close()

@router.get("/{drug_id}", deprecated=True)
async def get_drug_details_legacy(drug_id: int):
    """
    DEPRECATED: Use /api/v1/snomed/brands/{snomed_id} instead
    
    Legacy drug details (114 brands only)
    """
    warnings.warn("This endpoint is deprecated. Use /api/v1/snomed/brands/{id}", DeprecationWarning)
    db = SessionLocal()
    try:
        sql = text("""
            SELECT ibd.*, gi.ingredient_name, gi.indications, gi.symptoms
            FROM indian_brand_drugs ibd
            JOIN generic_ingredients gi ON ibd.ingredient_id = gi.ingredient_id
            WHERE ibd.brand_id = :id
        """)
        result = db.execute(sql, {"id": drug_id}).fetchone()
        
        if not result:
            raise HTTPException(404, "Drug not found")
        
        data = dict(result._mapping)
        data["warning"] = "DEPRECATED: Use /api/v1/snomed/brands/{snomed_id}"
        return data
    finally:
        db.close()

